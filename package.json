{
  "name": "deyon",
  "productName": "Deyon",
  "version": "0.1.2",
  "description": "A cross-platform download manager GUI built on top of aria2",
  "main": "src/main/main.js",
  "author": "dsameendra",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dsameendra/deyon.git"
  },
  "scripts": {
    "start": "electron .",
    "fetch:aria2:win": "node scripts/fetch-aria2-windows.mjs",
    "build:aria2:mac": "bash scripts/build-aria2-macos.sh",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.dsameendra.deyon",
    "productName": "Deyon",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin/${os}",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/certs",
        "to": "certs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterSign": "scripts/afterSign.js",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true
  }
}
